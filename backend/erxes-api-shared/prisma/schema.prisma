}

model CPComment {
  id        String   @id @default(uuid())
  phone     String?
  typeId    String
  type      String
  content   String?
  parentId  String?
  userId    String?
  userType  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([typeId])
  @@map("client_portal_comments")
}

model CPNotification {
  id             String    @id @default(uuid())
  cpUserId       String
  clientPortalId String
  title          String
  message        String
  type           String    @default("info")
  contentType    String?
  contentTypeId  String?
  isRead         Boolean   @default(false)
  readAt         DateTime?
  priority       String    @default("medium")
  priorityLevel  Int       @default(2)
  metadata       Json?
  action         String?
  kind           String    @default("user")
  result         Json?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([cpUserId, createdAt(sort: Desc)])
  @@index([clientPortalId, cpUserId, isRead])
  @@index([contentType, contentTypeId, cpUserId])
  @@index([action])
  @@index([kind])
  @@map("client_portal_notifications")
}

model EngageMessage {
  id                           String   @id @default(uuid())
  kind                         String
  targetType                   String?
  targetIds                    String[] @default([])
  targetCount                  Int?
  title                        String
  fromUserId                   String
  method                       String
  isDraft                      Boolean
  isLive                       Boolean
  messengerReceivedCustomerIds String[] @default([])
  email                        Json?
  messenger                    Json?
  notification                 Json?
  lastRunAt                    DateTime?
  runCount                     Int      @default(0)
  status                       String?
  progress                     Json?
  totalCustomersCount          Int?
  validCustomersCount          Int?
  createdBy                    String
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@map("broadcast_engage_messages")
}

model Stats {
  id               String   @id @default(uuid())
  engageMessageId  String   @unique
  createdAt        DateTime @default(now())
  open             Int      @default(0)
  click            Int      @default(0)
  complaint        Int      @default(0)
  delivery         Int      @default(0)
  bounce           Int      @default(0)
  reject           Int      @default(0)
  send             Int      @default(0)
  renderingfailure Int      @default(0)
  total            Int      @default(0)

  @@map("broadcast_stats")
}

model DeliveryReport {
  id              String   @id @default(uuid())
  customerId      String
  mailId          String?
  status          String?
  engageMessageId String?
  createdAt       DateTime @default(now())
  email           String

  @@index([customerId])
  @@index([mailId])
  @@index([status])
  @@index([engageMessageId])
  @@index([createdAt(sort: Desc)])
  @@index([email])
  @@map("broadcast_delivery_reports")
}

model BroadcastTrace {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  engageMessageId String
  message         String
  type            String

  @@index([engageMessageId])
  @@map("broadcast_traces")
}

model SmsRequest {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  engageMessageId String?
  to              String?
  requestData     String?
  status          String?
  responseData    String?
  telnyxId        String?
  statusUpdates   Json?    @default("[]")
  errorMessages   String[] @default([])

  @@map("broadcast_engage_sms_requests")
}

model AiAgent {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  connection  Json
  runtime     Json
  context     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("automations_ai_agents")
}

model BundleCondition {
  id          String   @id @default(uuid())
  code        String
  name        String
  userId      String
  isDefault   Boolean? @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("bundle_conditions")
}

model BundleRule {
  id          String   @id @default(uuid())
  code        String
  name        String
  description String?
  rules       Json?    @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("bundle_rules")
}

model PermissionGroup {
  id          String   @id @default(uuid())
  name        String?
  description String?
  permissions Json?    @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("permission_groups")
}

model Template {
  id              String   @id @default(uuid())
  name            String
  description     String?
  contentType     String
  content         Json
  relatedContents Json?    @default("[]")
  categoryIds     String[] @default([])
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("templates")
}

model TemplateCategory {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  code      String
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("template_categories")
}

model Log {
  id          String   @id @default(uuid())
  source      String?
  status      String
  createdAt   DateTime @default(now())
  userId      String?
  docId       String?
  payload     Json?
  action      String?
  processId   String?
  contentType String?

  @@index([createdAt])
  @@index([docId, createdAt(sort: Desc)])
  @@index([contentType, createdAt(sort: Desc)])
  @@map("logs")
}

model Translation {
  id             String   @id @default(uuid())
  clientPortalId String?
  namespace      String
  language       String
  key            String
  value          String
  updatedAt      DateTime @updatedAt
  updatedBy      String?

  @@unique([clientPortalId, namespace, language, key])
  @@index([clientPortalId, namespace, language])
  @@map("translations")
}

model Language {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("languages")
}
