model CPUser {
  id                        String    @id @default(uuid())
  username                  String?
  email                     String?
  phone                     String?
  code                      String?
  password                  String?
  firstName                 String?
  lastName                  String?
  avatar                    String?
  type                      String    @default("customer")
  companyName               String?
  companyRegistrationNumber String?
