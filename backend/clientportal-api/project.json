{
  "name": "clientportal-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "backend/clientportal-api/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "backend/clientportal-api",
        "assets": ["backend/clientportal-api/src/private/**/*"],
        "commands": ["pnpm build"]
      },
      "dependsOn": ["^build"]
    },

    "build:packageJson": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'skip'"
      }
    },

    "start": {
      "executor": "nx:run-commands",
      "dependsOn": ["typecheck", "build"],
      "options": {
        "cwd": "backend/clientportal-api",
        "command": "NODE_ENV=development && node dist/src/main.js"
      }
    },

    "serve": {
      "executor": "nx:run-commands",

      "options": {
        "cwd": "backend/clientportal-api",
        "command": "NODE_ENV=development pnpm dev"
      }
    },

    "docker-build": {
      "dependsOn": ["build"],
      "command": "docker build -f backend/clientportal-api/Dockerfile . -t erxes/erxes-next-clientportal-api"
    }
  }
}
